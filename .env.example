# Скопируйте в .env: cp .env.example .env

# --- Нейросеть ---
# mock — разбор по ключевым словам без внешнего API (по умолчанию, ключи не нужны)
# openai — любой OpenAI-совместимый API: OpenAI, OpenRouter, DeepSeek, vLLM, Ollama
# yandex — YandexGPT, данные не покидают РФ
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Для моделей GPT-5 и o-серии: none, minimal, low, medium, high. Пусто — не передаётся
OPENAI_REASONING_EFFORT=
# json_schema для OpenAI/OpenRouter; json_object для API без поддержки строгих схем (DeepSeek)
OPENAI_JSON_MODE=json_schema

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt/latest

# --- Защита бюджета публичного демо ---
MAX_LEAD_CHARS=4000
TRIAGES_PER_HOUR=30
# Доска посетителя удаляется через сутки без визитов; при следующем визите демо создаётся заново
BOARD_TTL_HOURS=24

# --- Инфраструктура (для запуска без Docker) ---
# Подходят и строки вида postgres://…?sslmode=require (Neon, Supabase) — они приводятся к asyncpg
DATABASE_URL=postgresql+asyncpg://leadsort:leadsort@localhost:5433/leadsort
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
# Регулярка для превью-деплоев, например ^https://leadsort-.*\.vercel\.app$
CORS_ORIGIN_REGEX=

# --- Очередь разбора ---
# inline — фоновая задача в процессе API (Docker, VPS); poll — без фоновых процессов, для Vercel
# (там выбирается сам)
QUEUE_MODE=inline
# Секрет для Vercel Cron, который раз в сутки вызывает /api/cron/cleanup
CRON_SECRET=
